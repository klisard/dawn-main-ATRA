{%- comment -%}
  Atra - product description as a collapsible row, matching Dawn's accordion
  markup so it lines up with the collapsible_tab blocks that follow.
  Used from the product template as a Custom Liquid block:
    {% render 'atra-pdp-description' %}
{%- endcomment -%}
{%- if product.description != blank -%}
  <div class="product__accordion accordion quick-add-hidden atra-pdp__description">
    <details id="Details-atra-description-{{ product.id }}" open>
      <summary>
        <div class="summary__title">
          <h2 class="h4 accordion__title inline-richtext">{{ 'atra.description' | t }}</h2>
        </div>
        {{- 'icon-caret.svg' | inline_asset_content -}}
      </summary>
      <div class="accordion__content rte" id="ProductAccordion-atra-description-{{ product.id }}">
        {{ product.description }}
      </div>
    </details>
  </div>
{%- endif -%}
