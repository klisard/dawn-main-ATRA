{
  "sections": {
    "crumbs": {
      "type": "atra-breadcrumbs",
      "settings": {
        "menu": "main-menu",
        "color_scheme": "scheme-1",
        "padding_top": 20,
        "padding_bottom": 0
      }
    },
    "main": {
      "type": "main-product",
      "blocks": {
        "vendor": {
          "type": "text",
          "settings": {
            "text": "{{ product.vendor }}",
            "text_style": "body"
          }
        },
        "title": {
          "type": "title"
        },
        "price": {
          "type": "price"
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "circle"
          }
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": false,
            "show_gift_card_recipient": false
          }
        },
        "atra_extras": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'atra-pdp-extras' %}"
          }
        },
        "atra_stock": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'atra-store-stock' %}"
          }
        },
        "atra_description": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'atra-pdp-description' %}"
          }
        },
        "acc_fit": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Përmasa & fit",
            "icon": "none",
            "content": "<p>Fit i rregullt. Për shtresa poshtë, merr një përmasë më lart.</p>"
          }
        },
        "acc_material": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Materiali & kujdesi",
            "icon": "none",
            "content": "<p>Shiko etiketën e produktit për përbërjen dhe udhëzimet e larjes.</p>"
          }
        },
        "acc_shipping": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Dërgesa & kthimi",
            "icon": "none",
            "content": "<p>1–3 ditë pune. Kthim brenda 14 ditësh, në dyqan ose me postë.</p>"
          }
        },
        "sku": {
          "type": "sku",
          "settings": {
            "text_style": "body"
          }
        }
      },
      "block_order": [
        "vendor",
        "title",
        "price",
        "sku",
        "variant_picker",
        "buy_buttons",
        "atra_extras",
        "atra_stock",
        "atra_description",
        "acc_fit",
        "acc_material",
        "acc_shipping"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_size": "large",
        "constrain_to_viewport": false,
        "media_fit": "cover",
        "gallery_layout": "columns",
        "media_position": "left",
        "image_zoom": "lightbox",
        "mobile_thumbnails": "hide",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 24,
        "padding_bottom": 24
      }
    },
    "disclosures": {
      "type": "disclosures",
      "settings": {
        "padding_top": 36,
        "padding_bottom": 0
      }
    },
    "related": {
      "type": "related-products",
      "settings": {
        "heading": "Plotëso lookun",
        "heading_size": "h2",
        "products_to_show": 4,
        "columns_desktop": 4,
        "columns_mobile": "2",
        "color_scheme": "scheme-2",
        "image_ratio": "portrait",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": true,
        "show_rating": false,
        "padding_top": 56,
        "padding_bottom": 56
      }
    },
    "recent": {
      "type": "atra-recently-viewed",
      "settings": {
        "heading": "Të shikuara së fundi",
        "limit": 5,
        "color_scheme": "scheme-1",
        "padding_top": 48,
        "padding_bottom": 64
      }
    }
  },
  "order": [
    "crumbs",
    "main",
    "disclosures",
    "related",
    "recent"
  ]
}
