{
  "sections": {
    "header": {
      "type": "atra-collection-header",
      "settings": {
        "menu": "main-menu",
        "show_breadcrumbs": true,
        "show_description": true,
        "show_subnav": true,
        "color_scheme": "scheme-1",
        "padding_top": 24,
        "padding_bottom": 8
      }
    },
    "product-grid": {
      "type": "main-collection-product-grid",
      "settings": {
        "products_per_page": 24,
        "columns_desktop": 4,
        "columns_mobile": "2",
        "color_scheme": "scheme-1",
        "image_ratio": "portrait",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": true,
        "show_rating": false,
        "quick_add": "none",
        "enable_filtering": true,
        "filter_type": "vertical",
        "enable_sorting": true,
        "padding_top": 24,
        "padding_bottom": 80
      }
    }
  },
  "order": ["header", "product-grid"]
}
