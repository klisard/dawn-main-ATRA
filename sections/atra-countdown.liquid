{%- comment -%} Atra - sale countdown band {%- endcomment -%}
{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  #shopify-section-{{ section.id }} .atra-countdown__eyebrow { color: {{ section.settings.accent }}; }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<atra-countdown
  class="atra-countdown color-{{ section.settings.color_scheme }} gradient"
  data-deadline="{{ section.settings.deadline | escape }}"
  {% if section.settings.hide_when_expired %}data-hide-when-expired{% endif %}
>
  <div class="page-width atra-countdown__inner section-{{ section.id }}-padding">
    <div class="atra-countdown__copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="atra-countdown__eyebrow atra-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <div class="atra-countdown__heading">{{ section.settings.heading }}</div>
      {%- endif -%}
    </div>

    <div class="atra-countdown__right">
      <div class="atra-countdown__clock" role="timer" aria-live="off">
        <div class="atra-countdown__unit"><span data-days>--</span><em>{{ 'atra.countdown.days' | t }}</em></div>
        <div class="atra-countdown__unit"><span data-hours>--</span><em>{{ 'atra.countdown.hours' | t }}</em></div>
        <div class="atra-countdown__unit"><span data-minutes>--</span><em>{{ 'atra.countdown.minutes' | t }}</em></div>
        <div class="atra-countdown__unit"><span data-seconds>--</span><em>{{ 'atra.countdown.seconds' | t }}</em></div>
      </div>
      {%- if section.settings.link != blank and section.settings.link_label != blank -%}
        <a class="atra-link atra-countdown__cta" href="{{ section.settings.link }}">{{ section.settings.link_label | escape }}</a>
      {%- endif -%}
    </div>
  </div>
</atra-countdown>

<script>
  if (!customElements.get('atra-countdown')) {
    customElements.define(
      'atra-countdown',
      class extends HTMLElement {
        connectedCallback() {
          this.deadline = new Date(this.dataset.deadline).getTime();
          if (isNaN(this.deadline)) return;
          this.els = {
            days: this.querySelector('[data-days]'),
            hours: this.querySelector('[data-hours]'),
            minutes: this.querySelector('[data-minutes]'),
            seconds: this.querySelector('[data-seconds]'),
          };
          this.tick();
          this.timer = setInterval(() => this.tick(), 1000);
        }
        disconnectedCallback() {
          clearInterval(this.timer);
        }
        tick() {
          const left = Math.max(0, this.deadline - Date.now());
          const pad = (n) => String(n).padStart(2, '0');
          this.els.days.textContent = pad(Math.floor(left / 864e5));
          this.els.hours.textContent = pad(Math.floor(left / 36e5) % 24);
          this.els.minutes.textContent = pad(Math.floor(left / 6e4) % 60);
          this.els.seconds.textContent = pad(Math.floor(left / 1e3) % 60);
          if (left === 0) {
            clearInterval(this.timer);
            if (this.hasAttribute('data-hide-when-expired') && !window.Shopify?.designMode) this.hidden = true;
          }
        }
      }
    );
  }
</script>

{% schema %}
{
  "name": "Atra countdown",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Ulje sezonale"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>Deri në <em>−50%</em> në artikuj të përzgjedhur</p>"
    },
    {
      "type": "text",
      "id": "deadline",
      "label": "Deadline",
      "info": "Format YYYY-MM-DDTHH:MM:SS in the visitor's local time, e.g. 2026-10-01T23:59:59",
      "default": "2026-10-01T23:59:59"
    },
    {
      "type": "checkbox",
      "id": "hide_when_expired",
      "label": "Hide the band when the countdown reaches zero",
      "default": false
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Shiko uljet"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-3"
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Eyebrow colour",
      "default": "#c9a98f"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Atra countdown"
    }
  ]
}
{% endschema %}
