{%- comment -%} Atra - shop the look: one editorial image + a shoppable product list {%- endcomment -%}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="atra-look color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width atra-look__inner atra-look__inner--{{ section.settings.image_position }} section-{{ section.id }}-padding">
    <div class="atra-look__media">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1400
          | image_tag:
            loading: 'lazy',
            widths: '600,900,1200,1400',
            sizes: '(min-width: 990px) 50vw, 100vw',
            alt: section.settings.heading,
            class: 'atra-look__img'
        }}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'atra-look__img placeholder-svg' }}
      {%- endif -%}
    </div>

    <div class="atra-look__body">
      {%- if section.settings.eyebrow != blank -%}
        <p class="atra-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="atra-look__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="atra-look__text rte">{{ section.settings.text }}</div>
      {%- endif -%}

      <div class="atra-look__list">
        {%- for block in section.blocks -%}
          {%- assign p = block.settings.product -%}
          {%- if p != blank -%}
            <a class="atra-look__row" href="{{ p.url }}" {{ block.shopify_attributes }}>
              <span class="atra-look__thumb">
                {%- if p.featured_image != blank -%}
                  {{
                    p.featured_image
                    | image_url: width: 200
                    | image_tag: loading: 'lazy', widths: '100,200', alt: p.title, class: 'atra-look__thumb-img'
                  }}
                {%- endif -%}
              </span>
              <span class="atra-look__meta">
                {%- if p.vendor != blank -%}
                  <span class="atra-look__vendor">{{ p.vendor | escape }}</span>
                {%- endif -%}
                <span class="atra-look__title">{{ p.title | escape }}</span>
              </span>
              <span class="atra-look__price">
                {%- render 'price', product: p, show_compare_at_price: true -%}
              </span>
            </a>
          {%- elsif request.design_mode -%}
            <div class="atra-look__row atra-look__row--empty" {{ block.shopify_attributes }}>
              <span class="atra-look__thumb"></span>
              <span class="atra-look__meta"><span class="atra-look__title">{{ 'atra.look.pick_product' | t }}</span></span>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Atra shop the look",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Editorial image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Shop the look · Nr. 04"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Kafe, kashmir dhe lëkurë"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Një paletë e vetme, tre copë. Kombinim për ditë pune dhe darkë pa ndërruar veshje.</p>"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Atra shop the look",
      "blocks": [{ "type": "item" }, { "type": "item" }, { "type": "item" }]
    }
  ]
}
{% endschema %}
