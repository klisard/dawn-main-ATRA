{%- comment -%}
  Atra - store locator. Blocks are stores; Maps link is a plain URL so no API key is needed.
{%- endcomment -%}
{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="atra-stores color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    {%- if section.settings.heading != blank -%}
      <h1 class="atra-stores__heading">{{ section.settings.heading | escape }}</h1>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="atra-stores__intro rte">{{ section.settings.text }}</div>
    {%- endif -%}

    <div class="atra-stores__grid">
      {%- for block in section.blocks -%}
        <div class="atra-stores__card" {{ block.shopify_attributes }}>
          <div class="atra-stores__media">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 1000
                | image_tag:
                  loading: 'lazy',
                  widths: '400,700,1000',
                  sizes: '(min-width: 990px) 33vw, 100vw',
                  alt: block.settings.city,
                  class: 'atra-stores__img'
              }}
            {%- else -%}
              {{ 'lifestyle-2' | placeholder_svg_tag: 'atra-stores__img placeholder-svg' }}
            {%- endif -%}
          </div>
          <div class="atra-stores__body">
            <h2 class="atra-stores__city">{{ block.settings.city | escape }}</h2>
            {%- if block.settings.address != blank -%}
              <p class="atra-stores__addr">{{ block.settings.address | escape }}</p>
            {%- endif -%}
            {%- if block.settings.hours != blank -%}
              <p class="atra-stores__meta">{{ block.settings.hours | escape }}</p>
            {%- endif -%}
            {%- if block.settings.phone != blank -%}
              <p class="atra-stores__meta">
                <a href="tel:{{ block.settings.phone | remove: ' ' }}">{{ block.settings.phone | escape }}</a>
              </p>
            {%- endif -%}
            <div class="atra-stores__actions">
              {%- if block.settings.maps_url != blank -%}
                <a class="button button--secondary" href="{{ block.settings.maps_url }}" target="_blank" rel="noopener">
                  {{- section.settings.maps_label | escape -}}
                </a>
              {%- endif -%}
              {%- if block.settings.whatsapp != blank -%}
                {%- assign wa = block.settings.whatsapp | remove: '+' | remove: ' ' | remove: '-' -%}
                <a class="button button--secondary atra-stores__wa" href="https://wa.me/{{ wa }}" target="_blank" rel="noopener">WhatsApp</a>
              {%- endif -%}
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Atra store locator",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Dyqanet tona"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Intro",
      "default": "<p>Rezervo online dhe provo brenda 48 orësh. Konsulencë stili pa pagesë në të tre dyqanet.</p>"
    },
    {
      "type": "text",
      "id": "maps_label",
      "label": "Maps button label",
      "default": "Hap në Maps"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "store",
      "name": "Store",
      "settings": [
        { "type": "text", "id": "city", "label": "Store name", "default": "Atra Tiranë" },
        { "type": "text", "id": "address", "label": "Address" },
        { "type": "text", "id": "hours", "label": "Opening hours" },
        { "type": "text", "id": "phone", "label": "Phone" },
        { "type": "url", "id": "maps_url", "label": "Google Maps URL" },
        { "type": "text", "id": "whatsapp", "label": "WhatsApp number", "default": "+355697986902" },
        { "type": "image_picker", "id": "image", "label": "Photo" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Atra store locator",
      "blocks": [
        {
          "type": "store",
          "settings": {
            "city": "Atra Tiranë",
            "address": "Rruga Myslym Shyri 42",
            "hours": "Hën–Sht 10:00–21:00 · Die 11:00–19:00",
            "phone": "+355 69 798 6902"
          }
        },
        {
          "type": "store",
          "settings": {
            "city": "Atra Fier",
            "address": "Rruga Jakov Xoxa",
            "hours": "Hën–Sht 09:30–20:30 · Die e mbyllur",
            "phone": "+355 69 798 6902"
          }
        },
        {
          "type": "store",
          "settings": {
            "city": "Atra Vlorë",
            "address": "Bulevardi Ismail Qemali",
            "hours": "Hën–Sht 10:00–22:00 · Die 12:00–20:00",
            "phone": "+355 69 798 6902"
          }
        }
      ]
    }
  ]
}
{% endschema %}
