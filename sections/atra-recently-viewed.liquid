{%- comment -%}
  Atra - recently viewed products. Handles are kept in localStorage on the
  visitor's device; cards are rendered by Shopify via sections/atra-product-card.
{%- endcomment -%}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
<script src="{{ 'atra-recently-viewed.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<atra-recently-viewed
  class="atra-recent color-{{ section.settings.color_scheme }} gradient"
  data-limit="{{ section.settings.limit }}"
  data-current="{{ product.handle }}"
  data-root="{{ routes.root_url }}"
  data-section="{{ section.id }}"
  hidden
>
  <div class="page-width section-{{ section.id }}-padding">
    {%- if section.settings.heading != blank -%}
      <h2 class="atra-eyebrow atra-recent__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    <ul
      class="atra-recent__grid grid product-grid grid--2-col-tablet-down grid--{{ section.settings.limit | at_most: 5 }}-col-desktop"
      role="list"
      data-atra-recent-list
    ></ul>
  </div>
</atra-recently-viewed>

{% schema %}
{
  "name": "Atra recently viewed",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Të shikuara së fundi"
    },
    {
      "type": "range",
      "id": "limit",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 5,
      "label": "Products to show"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Atra recently viewed"
    }
  ]
}
{% endschema %}
