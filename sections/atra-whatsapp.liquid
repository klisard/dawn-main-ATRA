{%- comment -%}
  Atra - floating WhatsApp button. Lives in the footer section group so it is on every page.
  Number and default message fall back to Theme settings -> Atra.
{%- endcomment -%}
{%- liquid
  assign number = section.settings.number | default: settings.atra_whatsapp
  assign number = number | remove: '+' | remove: ' ' | remove: '-'
  assign message = section.settings.message | default: settings.atra_whatsapp_message
  if template.name == 'product' and product != blank
    assign message = message | append: ' ' | append: product.title | append: ' - ' | append: shop.url | append: product.url
  endif
-%}

{%- if settings.atra_whatsapp_float and number != blank -%}
  <a
    class="atra-wa atra-wa--{{ section.settings.position }}{% unless section.settings.show_desktop %} atra-wa--mobile-only{% endunless %}"
    href="https://wa.me/{{ number }}?text={{ message | url_encode }}"
    target="_blank"
    rel="noopener"
    aria-label="{{ 'atra.whatsapp.float_label' | t }}"
  >
    <svg class="atra-wa__icon" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
      <path fill="currentColor" d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22c5.46 0 9.91-4.45 9.91-9.91S17.5 2 12.04 2m0 1.67c4.54 0 8.24 3.7 8.24 8.24s-3.7 8.24-8.24 8.24c-1.5 0-2.96-.41-4.24-1.18l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.27-4.35c0-4.54 3.7-8.24 8.24-8.24m-3.4 4.4c-.17 0-.45.06-.68.31-.23.26-.9.88-.9 2.14s.92 2.48 1.05 2.65c.13.17 1.8 2.75 4.36 3.86 2.13.84 2.56.68 3.02.63.46-.04 1.5-.61 1.71-1.2.21-.6.21-1.1.15-1.21-.06-.1-.23-.17-.49-.3s-1.5-.74-1.73-.82c-.23-.09-.4-.13-.57.12-.17.26-.65.83-.8 1-.15.17-.3.19-.55.06-.26-.13-1.08-.4-2.06-1.27-.76-.68-1.27-1.51-1.42-1.77-.15-.25-.02-.39.11-.52.12-.11.26-.3.38-.44.13-.15.17-.26.26-.43.08-.17.04-.32-.02-.45-.07-.13-.57-1.38-.79-1.89-.2-.5-.42-.43-.57-.44h-.46Z"/>
    </svg>
    <span class="atra-wa__label">WhatsApp</span>
  </a>
{%- endif -%}

{% schema %}
{
  "name": "Atra WhatsApp button",
  "tag": "div",
  "class": "atra-wa-section",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "The number and default message come from Theme settings → Atra unless overridden here."
    },
    {
      "type": "text",
      "id": "number",
      "label": "WhatsApp number (override)"
    },
    {
      "type": "text",
      "id": "message",
      "label": "Prefilled message (override)"
    },
    {
      "type": "checkbox",
      "id": "show_desktop",
      "label": "Show on desktop",
      "default": true
    },
    {
      "type": "select",
      "id": "position",
      "label": "Position",
      "options": [
        { "value": "right", "label": "Bottom right" },
        { "value": "left", "label": "Bottom left" }
      ],
      "default": "right"
    }
  ],
  "presets": [
    {
      "name": "Atra WhatsApp button"
    }
  ]
}
{% endschema %}
