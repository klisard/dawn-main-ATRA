{%- comment -%} Atra - numbered services band (01-04) {%- endcomment -%}
{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  #shopify-section-{{ section.id }} .atra-services__grid { --atra-cols: {{ section.settings.columns_desktop }}; }
  #shopify-section-{{ section.id }} .atra-services__n { color: {{ section.settings.accent }}; }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="atra-services color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    {%- if section.settings.heading != blank -%}
      <h2 class="atra-services__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    <div class="atra-services__grid">
      {%- for block in section.blocks -%}
        <div class="atra-services__item" {{ block.shopify_attributes }}>
          {%- if section.settings.show_numbers -%}
            <p class="atra-services__n">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</p>
          {%- endif -%}
          {%- if block.settings.title != blank -%}
            <h3 class="atra-services__title">{{ block.settings.title | escape }}</h3>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <div class="atra-services__text rte">{{ block.settings.text }}</div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Atra services",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4,
      "label": "Columns on desktop"
    },
    {
      "type": "checkbox",
      "id": "show_numbers",
      "label": "Show numbers",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-3"
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Number colour",
      "default": "#c9a98f"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "service",
      "name": "Service",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Dërgesa 1–3 ditë"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Shqipëri, Kosovë dhe Maqedoni. Falas mbi 8.000 Lek.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Atra services",
      "blocks": [
        {
          "type": "service",
          "settings": {
            "title": "Dërgesa 1–3 ditë",
            "text": "<p>Shqipëri, Kosovë dhe Maqedoni. Falas mbi 8.000 Lek.</p>"
          }
        },
        {
          "type": "service",
          "settings": {
            "title": "Provë në dyqan",
            "text": "<p>Rezervo online, provo në Tiranë, Fier ose Vlorë.</p>"
          }
        },
        {
          "type": "service",
          "settings": {
            "title": "Kthim brenda 14 ditësh",
            "text": "<p>Pa pyetje, me faturë dhe etiketë të paprishur.</p>"
          }
        },
        {
          "type": "service",
          "settings": {
            "title": "Porosi me WhatsApp",
            "text": "<p>Shkruaj +355 69 798 6902 — përgjigje brenda ditës.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
