{%- comment -%} Atra - rule-topped text columns (About values, size-guide notes) {%- endcomment -%}
{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  #shopify-section-{{ section.id }} .atra-columns__grid { --atra-cols: {{ section.settings.columns_desktop }}; }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="atra-columns color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width{% if section.settings.narrow %} page-width--narrow{% endif %} section-{{ section.id }}-padding">
    {%- if section.settings.heading != blank -%}
      <h2 class="atra-columns__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    <div class="atra-columns__grid">
      {%- for block in section.blocks -%}
        <div class="atra-columns__item" {{ block.shopify_attributes }}>
          {%- if block.settings.title != blank -%}
            <h3 class="atra-columns__title">{{ block.settings.title | escape }}</h3>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <div class="atra-columns__text rte">{{ block.settings.text }}</div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Atra columns",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4,
      "label": "Columns on desktop"
    },
    {
      "type": "checkbox",
      "id": "narrow",
      "label": "Narrow width",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Titull"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Tekst i shkurtër.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Atra columns",
      "blocks": [{ "type": "column" }, { "type": "column" }, { "type": "column" }, { "type": "column" }]
    }
  ]
}
{% endschema %}
