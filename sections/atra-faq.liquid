{%- comment -%} Atra - shipping & returns: sticky aside with rates + FAQ accordion {%- endcomment -%}
{{ 'component-accordion.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- assign rates = section.blocks | where: 'type', 'rate' -%}

<div class="atra-faq color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width atra-faq__inner section-{{ section.id }}-padding">
    <aside class="atra-faq__aside">
      {%- if section.settings.heading != blank -%}
        <h1 class="atra-faq__heading">{{ section.settings.heading | escape }}</h1>
      {%- endif -%}
      {%- if section.settings.intro != blank -%}
        <div class="atra-faq__intro rte">{{ section.settings.intro }}</div>
      {%- endif -%}

      {%- if rates.size > 0 -%}
        <div class="atra-box">
          {%- if section.settings.aside_title != blank -%}
            <p class="atra-box__title">{{ section.settings.aside_title | escape }}</p>
          {%- endif -%}
          <dl class="atra-box__rows">
            {%- for block in rates -%}
              <div class="atra-box__row" {{ block.shopify_attributes }}>
                <dt>{{ block.settings.label | escape }}</dt>
                <dd>{{ block.settings.value | escape }}</dd>
              </div>
            {%- endfor -%}
          </dl>
        </div>
      {%- endif -%}
    </aside>

    <div class="atra-faq__list">
      {%- for block in section.blocks -%}
        {%- if block.type == 'question' -%}
          <details class="atra-faq__item accordion" {{ block.shopify_attributes }}{% if block.settings.open %} open{% endif %}>
            <summary class="atra-faq__summary">
              <h2 class="atra-faq__q">{{ block.settings.heading | escape }}</h2>
              <span class="atra-faq__plus" aria-hidden="true">+</span>
            </summary>
            <div class="atra-faq__a rte">{{ block.settings.content }}</div>
          </details>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Atra shipping & FAQ",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Dërgesa & kthimi"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro",
      "default": "<p>Shqipëri, Kosovë dhe Maqedoni. Kthim brenda 14 ditësh.</p>"
    },
    {
      "type": "text",
      "id": "aside_title",
      "label": "Rates box title",
      "default": "Tarifat"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "rate",
      "name": "Rate",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Shqipëri" },
        { "type": "text", "id": "value", "label": "Value", "default": "300 Lek" }
      ]
    },
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "heading", "label": "Question", "default": "Sa kohë zgjat dërgesa?" },
        { "type": "richtext", "id": "content", "label": "Answer", "default": "<p>Tiranë 24 orë, qytetet e tjera 1–3 ditë pune.</p>" },
        { "type": "checkbox", "id": "open", "label": "Open by default", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "Atra shipping & FAQ",
      "blocks": [
        { "type": "rate", "settings": { "label": "Shqipëri", "value": "300 Lek" } },
        { "type": "rate", "settings": { "label": "Mbi 8.000 Lek", "value": "Falas" } },
        { "type": "rate", "settings": { "label": "Kosovë", "value": "600 Lek" } },
        { "type": "rate", "settings": { "label": "Maqedoni", "value": "700 Lek" } },
        { "type": "question", "settings": { "heading": "Sa kohë zgjat dërgesa?", "content": "<p>Tiranë 24 orë, qytetet e tjera 1–3 ditë pune. Kosovë dhe Maqedoni 2–5 ditë pune.</p>" } },
        { "type": "question", "settings": { "heading": "Sa kushton dërgesa?", "content": "<p>300 Lek brenda Shqipërisë, falas për porosi mbi 8.000 Lek. Kosovë 600 Lek, Maqedoni 700 Lek.</p>" } },
        { "type": "question", "settings": { "heading": "Si mund t’i kthej artikujt?", "content": "<p>Brenda 14 ditësh, me etiketë të paprishur dhe faturë. Kthimi kryhet në dyqan ose me postë.</p>" } },
        { "type": "question", "settings": { "heading": "Mund të ndërroj përmasën?", "content": "<p>Po — ndërrimi i përmasës është falas një herë për porosi, në varësi të stokut.</p>" } },
        { "type": "question", "settings": { "heading": "Si paguaj?", "content": "<p>Kartë (Visa, Mastercard), pagesë në dorëzim, ose bankë. Të gjitha çmimet me TVSH.</p>" } }
      ]
    }
  ]
}
{% endschema %}
