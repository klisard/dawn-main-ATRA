{%- comment -%} Atra - contact page: info column + form in a paper box {%- endcomment -%}
{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- assign subjects = section.settings.subjects | newline_to_br | split: '<br />' -%}

<div class="atra-contact color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width atra-contact__inner section-{{ section.id }}-padding">
    <div class="atra-contact__info">
      {%- if section.settings.heading != blank -%}
        <h1 class="atra-contact__heading">{{ section.settings.heading | escape }}</h1>
      {%- else -%}
        <h1 class="visually-hidden">{{ 'templates.contact.form.title' | t }}</h1>
      {%- endif -%}
      {%- if section.settings.intro != blank -%}
        <div class="atra-contact__intro rte">{{ section.settings.intro }}</div>
      {%- endif -%}

      <div class="atra-contact__rows">
        {%- for block in section.blocks -%}
          <div class="atra-contact__row" {{ block.shopify_attributes }}>
            {%- if block.settings.label != blank -%}
              <p class="atra-eyebrow">{{ block.settings.label | escape }}</p>
            {%- endif -%}
            <div class="atra-contact__value rte">{{ block.settings.value }}</div>
          </div>
        {%- endfor -%}
      </div>
    </div>

    {%- form 'contact', id: 'AtraContactForm', class: 'atra-contact__form atra-box' -%}
      {%- if section.settings.form_heading != blank -%}
        <p class="atra-box__title">{{ section.settings.form_heading | escape }}</p>
      {%- endif -%}

      {%- if form.posted_successfully? -%}
        <p class="form-status form-status-list form__message atra-contact__ok" tabindex="-1" autofocus>
          {{- 'icon-success.svg' | inline_asset_content -}}
          {%- if section.settings.success_text != blank -%}
            {{ section.settings.success_text | escape }}
          {%- else -%}
            {{ 'templates.contact.form.post_success' | t }}
          {%- endif -%}
        </p>
      {%- elsif form.errors -%}
        <div class="form__message">
          <p class="form-status caption-large text-body" role="alert" tabindex="-1" autofocus>
            {{- 'icon-error.svg' | inline_asset_content -}}
            {{ 'templates.contact.form.error_heading' | t }}
          </p>
        </div>
        <ul class="form-status-list caption-large" role="list">
          <li>
            <a href="#AtraContactForm-email" class="link">
              {{ form.errors.translated_fields.email | capitalize }}
              {{ form.errors.messages.email }}
            </a>
          </li>
        </ul>
      {%- endif -%}

      <div class="atra-field">
        <input
          class="atra-field__input"
          autocomplete="name"
          type="text"
          id="AtraContactForm-name"
          name="contact[{{ 'templates.contact.form.name' | t }}]"
          value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
          placeholder="{{ 'templates.contact.form.name' | t }}"
        >
        <label class="visually-hidden" for="AtraContactForm-name">{{ 'templates.contact.form.name' | t }}</label>
      </div>
      <div class="atra-field">
        <input
          autocomplete="email"
          type="email"
          id="AtraContactForm-email"
          class="atra-field__input"
          name="contact[email]"
          spellcheck="false"
          autocapitalize="off"
          value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
          aria-required="true"
          {% if form.errors contains 'email' %}
            aria-invalid="true"
            aria-describedby="AtraContactForm-email-error"
          {% endif %}
          placeholder="{{ 'templates.contact.form.email' | t }}"
          required
        >
        <label class="visually-hidden" for="AtraContactForm-email">{{ 'templates.contact.form.email' | t }} <span aria-hidden="true">*</span></label>
        {%- if form.errors contains 'email' -%}
          <small class="contact__field-error" id="AtraContactForm-email-error">
            <span class="visually-hidden">{{ 'accessibility.error' | t }}</span>
            <span class="form__message">
              {{- 'icon-error.svg' | inline_asset_content -}}
              {{ form.errors.translated_fields.email | capitalize }}
              {{ form.errors.messages.email }}
            </span>
          </small>
        {%- endif -%}
      </div>
      {%- if subjects.size > 0 and section.settings.subjects != blank -%}
        <div class="atra-field">
          <label class="visually-hidden" for="AtraContactForm-subject">{{ 'atra.contact.subject' | t }}</label>
          <select id="AtraContactForm-subject" class="atra-field__input atra-field__select" name="contact[{{ 'atra.contact.subject' | t }}]">
            {%- for s in subjects -%}
              {%- assign st = s | strip -%}
              {%- if st != blank -%}
                <option value="{{ st | escape }}">{{ st | escape }}</option>
              {%- endif -%}
            {%- endfor -%}
          </select>
        </div>
      {%- endif -%}
      <div class="atra-field">
        <textarea
          rows="5"
          id="AtraContactForm-body"
          class="atra-field__input atra-field__textarea"
          name="contact[{{ 'templates.contact.form.comment' | t }}]"
          placeholder="{{ 'templates.contact.form.comment' | t }}"
        >
          {{- form.body -}}
        </textarea>
        <label class="visually-hidden" for="AtraContactForm-body">{{ 'templates.contact.form.comment' | t }}</label>
      </div>
      <button type="submit" class="button button--primary atra-contact__submit">
        {{ 'templates.contact.form.send' | t }}
      </button>
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Atra contact",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Kontakt"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro",
      "default": "<p>Përgjigjemi brenda ditës, nga e hëna në të shtunë.</p>"
    },
    {
      "type": "text",
      "id": "form_heading",
      "label": "Form heading",
      "default": "Shkruaj-na"
    },
    {
      "type": "textarea",
      "id": "subjects",
      "label": "Subject options (one per line)",
      "default": "Pyetje për produkt\nStatusi i porosisë\nKthim / ndërrim\nBashkëpunim"
    },
    {
      "type": "text",
      "id": "success_text",
      "label": "Success message",
      "default": "Faleminderit - do të përgjigjemi brenda ditës."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "info",
      "name": "Info row",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Email" },
        { "type": "richtext", "id": "value", "label": "Value", "default": "<p>shopping@atra.al</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Atra contact",
      "blocks": [
        { "type": "info", "settings": { "label": "Tel / WhatsApp", "value": "<p>+355 69 798 6902</p>" } },
        { "type": "info", "settings": { "label": "Email", "value": "<p>shopping@atra.al</p>" } },
        { "type": "info", "settings": { "label": "Porosi & kthime", "value": "<p>Ki gati numrin e porosisë (#ATR-xxxxx) për përgjigje më të shpejtë.</p>" } }
      ]
    }
  ]
}
{% endschema %}
