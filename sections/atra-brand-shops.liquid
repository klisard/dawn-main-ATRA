{%- comment -%} Atra - brand shops (attrattivo / ONLY / DESIREE) {%- endcomment -%}
{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="atra-brands atra-rule-top atra-rule-bottom color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="atra-brands__head">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="atra-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="atra-brands__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
      </div>
      {%- if section.settings.subtext != blank -%}
        <p class="atra-brands__subtext">{{ section.settings.subtext | escape }}</p>
      {%- endif -%}
    </div>

    <div class="atra-brands__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign coll = block.settings.collection
          assign title = block.settings.title | default: coll.title
          assign image = block.settings.image | default: coll.featured_image
          assign url = block.settings.link | default: coll.url | default: '#'
        -%}
        <a class="atra-brands__card" href="{{ url }}" {{ block.shopify_attributes }}>
          <div class="atra-brands__media">
            {%- if image != blank -%}
              {{
                image
                | image_url: width: 1000
                | image_tag:
                  loading: 'lazy',
                  widths: '400,600,800,1000',
                  sizes: '(min-width: 990px) 33vw, 100vw',
                  alt: title,
                  class: 'atra-brands__img'
              }}
            {%- else -%}
              {%- assign ph = forloop.index | modulo: 4 | plus: 1 -%}
              {{ 'collection-apparel-' | append: ph | placeholder_svg_tag: 'atra-brands__img placeholder-svg' }}
            {%- endif -%}
          </div>
          <div class="atra-brands__body">
            <p class="atra-brands__name">{{ title | escape }}</p>
            {%- if block.settings.text != blank -%}
              <p class="atra-brands__text">{{ block.settings.text | escape }}</p>
            {%- endif -%}
            {%- if block.settings.cta != blank -%}
              <span class="atra-link">{{ block.settings.cta | escape }}</span>
            {%- endif -%}
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Atra brand shops",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Dyqanet e brendeve"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tre brende. Një përzgjedhje unike."
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Sub text",
      "default": "Çdo brend sjell historinë, stilin dhe identitetin e tij - me koleksione të krijuara për t’iu përshtatur çdo siluete."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-2"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Overrides the collection image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Brand name"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Description"
        },
        {
          "type": "text",
          "id": "cta",
          "label": "Link label",
          "default": "Zbulo brendin"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Custom link",
          "info": "Overrides the collection link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Atra brand shops",
      "blocks": [
        {
          "type": "brand",
          "settings": {
            "title": "attrattivo",
            "text": "Baza greke: trika, bluza dhe copë të lehta për çdo ditë."
          }
        },
        {
          "type": "brand",
          "settings": {
            "title": "ONLY",
            "text": "Denim dhe siluetë e re daneze, përfshirë CARMAKOMA."
          }
        },
        {
          "type": "brand",
          "settings": {
            "title": "DESIREE",
            "text": "Copë statement - lëkurë, fustane dhe pallto."
          }
        }
      ]
    }
  ]
}
{% endschema %}
