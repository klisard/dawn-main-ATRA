{%- comment -%} Atra - Instagram-style square grid (manual images; no API needed) {%- endcomment -%}
{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  #shopify-section-{{ section.id }} .atra-ig__grid { --atra-cols: {{ section.settings.columns_desktop }}; }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="atra-ig color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="atra-ig__head">
      {%- if section.settings.eyebrow != blank -%}
        {%- if section.settings.profile_url != blank -%}
          <a class="atra-eyebrow atra-ig__handle" href="{{ section.settings.profile_url }}" target="_blank" rel="noopener">{{ section.settings.eyebrow | escape }}</a>
        {%- else -%}
          <p class="atra-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="atra-ig__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
    </div>

    <div class="atra-ig__grid">
      {%- for block in section.blocks -%}
        {%- assign url = block.settings.link | default: section.settings.profile_url -%}
        {%- if url != blank -%}
          <a class="atra-ig__tile" href="{{ url }}" target="_blank" rel="noopener" {{ block.shopify_attributes }}>
        {%- else -%}
          <div class="atra-ig__tile" {{ block.shopify_attributes }}>
        {%- endif -%}
          {%- if block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: 800
              | image_tag:
                loading: 'lazy',
                widths: '300,500,800',
                sizes: '(min-width: 990px) 17vw, 33vw',
                alt: block.settings.image.alt,
                class: 'atra-ig__img'
            }}
          {%- else -%}
            {%- assign ph = forloop.index | modulo: 4 | plus: 1 -%}
            {{ 'collection-apparel-' | append: ph | placeholder_svg_tag: 'atra-ig__img placeholder-svg' }}
          {%- endif -%}
        {%- if url != blank -%}
          </a>
        {%- else -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Atra Instagram grid",
  "tag": "section",
  "class": "section",
  "max_blocks": 12,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "@atra.albania"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Ju në Atra"
    },
    {
      "type": "url",
      "id": "profile_url",
      "label": "Instagram profile URL"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 3,
      "max": 6,
      "step": 1,
      "default": 6,
      "label": "Columns on desktop"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Defaults to the profile URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Atra Instagram grid",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
